# Public Supabase project configuration. These values are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APPROVAL_SIGNING_KEY=replace-with-at-least-32-random-characters

# Server-only AI credentials. Never prefix these with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional server-only integrations reserved for later phases.
TRIGGER_SECRET_KEY=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://localhost:3000/api/integrations/upwork/callback
UPWORK_API_BASE_URL=https://api.upwork.com
UPWORK_AUTH_BASE_URL=https://www.upwork.com
UPWORK_SCOPES=

# Encrypts integration access and refresh tokens at rest. Generate 32 random bytes
# and encode them as base64. Required before connecting an Upwork account.
INTEGRATION_ENCRYPTION_KEY=

